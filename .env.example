# ============================================================
# EyeLearning — env cho stack Docker local.
# Copy ra .env rồi điền secret: cp .env.example .env
#
# Chỉ khối "Bắt buộc" là cần thiết. Các khối còn lại đã có
# default trong docker-compose.yml / code, chỉ mở khi cần đổi.
# ============================================================

# ---------- Bắt buộc ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eyetracking

JWT_SECRET=generate-a-long-random-string
CORS_ORIGINS=http://localhost:3000
# Local chạy HTTP: phải false, nếu không login không giữ phiên.
COOKIE_SECURE=false

# DSN nội bộ compose (host `postgres`, cổng 5432).
# Nếu đổi POSTGRES_PASSWORD, sửa cả dòng này.
DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:change-me@postgres:5432/eyetracking
REDIS_URL_DOCKER=redis://redis:6379/0

CHATBOT_INTERNAL_TOKEN=generate-a-long-random-string
CHATBOT_DB_USER=chatbot_reader
CHATBOT_DB_PASSWORD=generate-a-long-random-string
# Nếu đổi CHATBOT_DB_PASSWORD, sửa cả dòng này.
CHATBOT_DATABASE_URL_DOCKER=postgresql://chatbot_reader:generate-a-long-random-string@postgres:5432/eyetracking

RIVER_API_KEY=change-me
RIVER_LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
RIVER_VLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

EMBEDDING_NAME=local
EMBEDDING_DIM=1024
EMBEDDING_MODEL_PATH=/app/weights/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cuda

# ---------- Cloudflare R2 (tùy chọn) ----------
# Điền cả 5 để lưu slide trên R2.
# Để trống cả 5 để dùng volume local `backend-media`.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# ---------- Tùy chọn nâng cao (mặc định đã đủ dùng) ----------
# Các biến tuning khác có default trong docker-compose.yml:
#   DEVICE, ONEEURO_*, SESSION_TTL_SECONDS, MAX_SESSIONS, MAX_POINTS,
#   MAX_SAMPLES_PER_POINT, INFER_WORKERS, MAX_UPLOAD_BYTES,
#   GAZE_DOWNSAMPLE_HZ, GAZE_BATCH_MAX, CHATBOT_*_TIMEOUT/ATTEMPTS,
#   LLM_NAME, VLM_NAME, RIVER_*, EMBEDDING_LOCAL_FILES_ONLY,
#   EMBEDDING_HF_REPO, RAG_*, CITATION_MAX_ATTEMPTS, HF_TOKEN,
#   STORAGE_PROVIDER, STORAGE_HTTP_ALLOWED_HOSTS, TRUSTED_PROXY_IPS,
#   DEBUG, COOKIE_SAMESITE.
# Thêm dòng `TÊN=giá_trị` vào đây nếu cần đổi.

# ---------- Chỉ dùng khi chạy backend/chatbot trên host ----------
# DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5435/eyetracking
# AI_HTTP_URL=http://127.0.0.1:8000
# CHATBOT_URL=http://localhost:8002
# CHATBOT_DATABASE_URL=postgresql://chatbot_reader:generate-a-long-random-string@localhost:5435/eyetracking
# LOCAL_MEDIA_DIR=../backend/media
# REDIS_URL=redis://localhost:6379/0
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=30
