# ============================================================
# EyeLearning — một file env duy nhất cho toàn bộ stack local.
# Copy ra .env (gitignored) rồi điền giá trị thật: cp .env.example .env
# ============================================================

# ---------- PostgreSQL (docker service `postgres`, cổng host 5435) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eyetracking

# ---------- Backend ----------
# Dùng cho test/host tools (kết nối qua cổng host 5435).
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5435/eyetracking
# Dùng trong docker-compose cho container backend (mạng nội bộ compose).
DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:change-me@postgres:5432/eyetracking

JWT_SECRET=generate-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Local: frontend chạy qua nginx tại http://localhost:3000.
CORS_ORIGINS=http://localhost:3000
DEBUG=false

# ---------- AI service (gaze, build từ services/gaze; cổng host 8000) ----------
# Dùng cho test/host tools; backend trong Docker dùng http://gaze:8000.
AI_HTTP_URL=http://127.0.0.1:8000
# Thiết bị suy luận: cuda | cpu (rỗng = tự dò GPU).
DEVICE=cuda
# One-Euro smoothing cho POG (xem services/gaze/app/services/smoothing.py).
ONEEURO_BETA=0.5
ONEEURO_MIN_CUTOFF=0.5
ONEEURO_D_CUTOFF=1.0
# Giới hạn session calibration của gaze service.
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=100
MAX_POINTS=64
MAX_SAMPLES_PER_POINT=50
INFER_WORKERS=1
MAX_UPLOAD_BYTES=5242880

# ---------- Gaze tuning ----------
GAZE_DOWNSAMPLE_HZ=4.0
GAZE_BATCH_MAX=2000

# ---------- Chatbot RAG (service riêng, gọi River AI) ----------
# Dùng cho test/host tools; backend trong Docker gọi http://chatbot:8000.
CHATBOT_URL=http://localhost:8002
CHATBOT_URL_DOCKER=http://chatbot:8000
CHATBOT_INTERNAL_TOKEN=generate-a-long-random-string
CHATBOT_TIMEOUT_SECONDS=120
CHATBOT_INGEST_TIMEOUT_SECONDS=600
CHATBOT_INGEST_ATTEMPTS=3
CHATBOT_INGEST_BACKOFF_SECONDS=5

# Chatbot kết nối Postgres bằng DSN psycopg (KHÔNG dùng +asyncpg).
# Role hạn chế: chỉ đọc course/lesson/slide + ghi embedding/status, KHÔNG đọc
# bảng quiz/users. Tạo role sau khi migrations chạy: ./ops/create_chatbot_role.sh
CHATBOT_DB_USER=chatbot_reader
CHATBOT_DB_PASSWORD=generate-a-long-random-string
CHATBOT_DATABASE_URL=postgresql://chatbot_reader:generate-a-long-random-string@localhost:5435/eyetracking
CHATBOT_DATABASE_URL_DOCKER=postgresql://chatbot_reader:generate-a-long-random-string@postgres:5432/eyetracking

# ---------- River AI (OpenAI-compatible) ----------
LLM_NAME=river
VLM_NAME=river
RIVER_API_KEY=change-me
RIVER_BASE_URL=https://api.river.ai/v1
RIVER_LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
RIVER_VLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
RIVER_LLM_MAX_TOKENS=8192
RIVER_ROUTER_MAX_TOKENS=1024
RIVER_VERIFIER_MAX_TOKENS=8192
RIVER_VLM_MAX_TOKENS=16384
RIVER_TIMEOUT=180
RIVER_MAX_RETRIES=2
RIVER_REASONING_EFFORT=low
RIVER_ROUTER_REASONING_EFFORT=none
RIVER_VERIFIER_REASONING_EFFORT=none
RIVER_VLM_REASONING_EFFORT=none

# ---------- Embedding local (Qwen3-Embedding-0.6B) ----------
EMBEDDING_NAME=local
EMBEDDING_DIM=1024
EMBEDDING_MODEL_PATH=/app/weights/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cuda
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_HF_REPO=Qwen/Qwen3-Embedding-0.6B

# ---------- RAG ----------
RAG_TOP_K=8
RAG_CANDIDATES=20
RAG_RRF_K=60
RAG_SCORE_THRESHOLD=0.25
CITATION_MAX_ATTEMPTS=2

# ---------- Chatbot storage ----------
# Khi chạy chatbot trên host: ../backend/media. Trong Docker compose: /app/media.
LOCAL_MEDIA_DIR=../backend/media
STORAGE_HTTP_ALLOWED_HOSTS=

# ---------- Cloudflare R2 (slide storage, tùy chọn) ----------
# Để trống toàn bộ để dùng volume local `backend-media`.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# ---------- Redis ----------
# Backend trong Docker dùng REDIS_URL_DOCKER. Host hot reload có thể đặt
# REDIS_URL=redis://localhost:6379/0 (để trống -> fallback in-memory).
# REDIS_URL=redis://localhost:6379/0
REDIS_URL_DOCKER=redis://redis:6379/0

# ---------- Proxy tin cậy & cookie ----------
# Chỉ peer trong dải CIDR này mới được tin header X-Forwarded-For.
TRUSTED_PROXY_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# Local chạy HTTP: phải false, nếu không login không giữ phiên.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
