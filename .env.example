# File này dùng cho stack local. Production qua Portainer dùng
# deploy/portainer/stack.env.example — xem deploy/portainer/README.md.

# ---------- Bắt buộc ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eyetracking

JWT_SECRET=generate-a-long-random-string
CORS_ORIGINS=http://localhost:3000
# Local chạy HTTP: phải false, nếu không login không giữ phiên.
COOKIE_SECURE=false
# Dải mạng proxy tin cậy (nginx trong Docker). Chỉ peer trong dải này mới được
# tin X-Forwarded-For. Không dùng "*".
TRUSTED_PROXY_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
FORWARDED_ALLOW_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# ---------- SMTP gửi OTP đăng nhập sinh viên ----------
# Để trống SMTP_HOST → API trả 503 cho yêu cầu OTP (trừ dev bật OTP_DEV_ECHO).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Trống → dùng SMTP_USER làm địa chỉ From.
SMTP_FROM=
SMTP_FROM_NAME=GazeEdu
# Trống → dùng địa chỉ From. Nên là hộp thư có người theo dõi.
SMTP_REPLY_TO=
# TLS ngầm (cổng 465) → true; STARTTLS (cổng 587) → false + SMTP_STARTTLS=true.
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15

# ---------- OTP đăng nhập sinh viên NEU ----------
# Mã 6 số, hiệu lực 15 phút, chỉ dùng một lần.
OTP_TTL_SECONDS=900
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_EMAIL_PER_HOUR=10
OTP_MAX_PER_IP_PER_HOUR=40
# Chỉ chấp nhận email trường; phần local phải khớp regex mã sinh viên.
OTP_ALLOWED_DOMAINS=st.neu.edu.vn
OTP_STUDENT_ID_PATTERN=^\d{8}$
# Trống → fallback JWT_SECRET khi tính HMAC cho mã OTP.
OTP_HASH_SECRET=
# Chỉ dùng dev: log mã OTP khi SMTP chưa cấu hình (DEBUG bắt buộc).
OTP_DEV_ECHO=false

# DSN nội bộ compose (host `postgres`, cổng 5432).
# Nếu đổi POSTGRES_PASSWORD, sửa cả dòng này.
DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:change-me@postgres:5432/eyetracking
REDIS_URL_DOCKER=redis://redis:6379/0

# ---------- Số replica Docker Compose ----------
# Chỉ áp dụng cho service không đặt container_name (frontend, gaze, worker).
# Giảm xuống 1 khi chạy local để tiết kiệm RAM/CPU.
FRONTEND_REPLICAS=2
# 1 GPU serialize inference: 2 replica không tăng throughput, chỉ tăng VRAM và
# cung cấp HA. Đặt 2 nếu cần chịu lỗi khi một process restart.
GAZE_REPLICAS=1
WORKER_REPLICAS=2

# ---------- Chạy backend/worker trên host (không Docker) ----------
# Docker compose tự set các biến này theo tên service; phần dưới dành cho
# `uvicorn`/worker chạy trực tiếp trên máy (postgres/redis vẫn trong compose).
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5435/eyetracking
REDIS_URL=redis://localhost:6379/0
AI_HTTP_URL=http://localhost:8000
CHATBOT_URL=http://localhost:8002
# Tương đối theo cwd (chạy `cd backend` → backend/media).
MEDIA_DIR=media
MAX_UPLOAD_BYTES=52428800
MAX_PDF_BYTES=104857600
MAX_SLIDE_PAGES=150
WORKER_POLL_SECONDS=5
WORKER_STALE_SECONDS=600
CONTENT_WORKER_POLL_SECONDS=3
EMBEDDING_WORKER_POLL_SECONDS=0.5
EMBEDDING_WORKER_CONCURRENCY=2
EMBEDDING_WORKER_STALE_SECONDS=600
# Số process API (uvicorn workers). Mỗi process có pool DB riêng.
WEB_CONCURRENCY=4
DB_POOL_MIN=4
DB_POOL_MAX=10
DB_POOL_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
# 0 = tương thích PgBouncer transaction pooling.
# Đặt 0 khi dùng profile `pgbouncer` (transaction pooling).
DB_PREPARED_STATEMENT_CACHE_SIZE=64
# Gaze: fp32 | fp16. fp16 nhanh ~2x và là mặc định sau khi A/B đạt gate trên
# `unigaze_b16_joint`; đặt fp32 nếu đổi model/GPU hoặc chạy DEVICE=cpu.
INFERENCE_PRECISION=fp16
# Số frame tối đa chờ trong queue CPU. Queue đầy -> trả overloaded ngay.
GAZE_MAX_QUEUE=8
# Số frame chờ trong queue GPU và số frame gộp vào một forward.
# Batch 8 cần GAZE_GPU_QUEUE >= 8; hạ batch khi chạy fp32 để giữ VRAM.
GAZE_GPU_QUEUE=12
GAZE_GPU_BATCH=8
# Frame cũ hơn ngưỡng này (ms) bị bỏ thay vì inference (giữ p95 latency bounded).
GAZE_FRAME_MAX_AGE_MS=200
# Timeout 1 job suy luận (giây).
GAZE_INFERENCE_TIMEOUT_S=5
# Kích thước JPEG tối đa cho 1 frame WebSocket.
GAZE_MAX_FRAME_BYTES=1048576
# Ảnh calibration/import tối đa (riêng của gaze; backend dùng MAX_UPLOAD_BYTES).
GAZE_MAX_UPLOAD_BYTES=5242880
# Frame/giây trình duyệt gửi lên gaze service. Backend trả lại qua GET /api/config
# và worker dùng để suy ra ngưỡng gap. Hợp lệ 1..60; khuyến nghị 6..30.
# Capacity/GPU (RTX 3060): 15 FPS ~7-8 phiên (fp32), ~15-16 phiên (fp16).
GAZE_FPS=15
# Xoá gaze_samples cũ hơn số ngày này (0 = tắt); schema 10 không dùng partition.
GAZE_RETENTION_DAYS=180
# Ngưỡng dwell (ms) để phân loại lượt xem "đủ ngưỡng". Mặc định vẫn hiển thị
# tất cả lượt; giá trị này dùng cho badge/filter "Chỉ lượt >= ngưỡng".
CONTENT_VIEW_MIN_DWELL_MS=1000
# Giới hạn upload riêng của gaze (không dùng chung MAX_UPLOAD_BYTES backend).
GAZE_MAX_UPLOAD_BYTES=5242880

# ---------- Model gaze chạy local (bắt buộc) ----------
# Không có default trong code/compose; thiếu -> container gaze fail-fast.
# Đổi cpu nếu máy không có GPU (và bỏ `gpus: all` trong compose).
DEVICE=cuda
# Chọn weights UniGaze: unigaze_b16_joint | unigaze_l16_joint |
# unigaze_h14_joint | unigaze_h14_cross_X.
UNIGAZE_MODEL=unigaze_b16_joint

# Chatbot có pool DB riêng; backend tiếp tục dùng DB_POOL_* phía trên.
CHATBOT_DB_POOL_MIN=1
CHATBOT_DB_POOL_MAX=10
CHATBOT_DB_POOL_TIMEOUT=10
CHATBOT_DB_POOL_RECONNECT_TIMEOUT=10

CHATBOT_INTERNAL_TOKEN=generate-a-long-random-string
CHATBOT_DB_USER=chatbot_reader
CHATBOT_DB_PASSWORD=generate-a-long-random-string
# Nếu đổi CHATBOT_DB_PASSWORD, sửa cả dòng này.
CHATBOT_DATABASE_URL_DOCKER=postgresql://chatbot_reader:generate-a-long-random-string@postgres:5432/eyetracking
# Ingest slide: batch 8 để chatbot gom embedding theo batch; timeout dài để
# bài nhiều trang không bị timeout.
CHATBOT_INGEST_BATCH_SIZE=8
CHATBOT_INGEST_ATTEMPTS=4
CHATBOT_INGEST_BACKOFF_SECONDS=10
CHATBOT_INGEST_TIMEOUT_SECONDS=900

# ---------- Truy vấn CSDL cho admin (chỉ đọc) ----------
# Role DB chỉ đọc, được tạo tự động bởi db/migrate.sh khi có 2 biến dưới.
ADMIN_DB_USER=admin_reader
ADMIN_DB_PASSWORD=generate-a-long-random-string
# Nếu đổi ADMIN_DB_PASSWORD, sửa cả 2 DSN dưới đây.
# DSN backend dùng trên host (dev). Để trống → fallback DATABASE_URL + read-only
# transaction (chỉ nên dùng ở dev).
ADMIN_DB_URL=postgresql+asyncpg://admin_reader:generate-a-long-random-string@localhost:5435/eyetracking
# DSN backend dùng trong Docker.
ADMIN_DATABASE_URL_DOCKER=postgresql+asyncpg://admin_reader:generate-a-long-random-string@postgres:5432/eyetracking
ADMIN_DB_STATEMENT_TIMEOUT_MS=10000
ADMIN_DB_LOCK_TIMEOUT_MS=2000
ADMIN_DB_MAX_ROWS=500
ADMIN_DB_SCHEMA_CACHE_SECONDS=60

# ---------- LLM/VLM (OpenAI-compatible) ----------
# Endpoint Chat Completions bất kỳ: vLLM, Ollama, OpenRouter, OpenAI, ...
# Đổi nhà cung cấp chỉ cần sửa nhóm biến LLM_*/VLM_*; không có key riêng cho từng vendor.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
# Chuẩn OpenAI là Authorization + Bearer. Với server dùng custom header
# (ví dụ Ollama với x-ollama-seckey), đặt LLM_AUTH_HEADER và để trống scheme.
# Để trống LLM_AUTH_HEADER nếu endpoint không yêu cầu auth.
LLM_AUTH_HEADER=Authorization
LLM_AUTH_SCHEME=Bearer
LLM_MODEL=your-llm-model
# Để trống -> dùng chung LLM_MODEL cho bước ingest slide.
VLM_MODEL=
LLM_ENABLE_THINKING=false
LLM_TIMEOUT=180
LLM_MAX_RETRIES=2
VLM_MAX_TOKENS=8192
VLM_TIMEOUT=300

# ---------- Model embedding chạy local (bắt buộc) ----------
# Không có default trong code/compose; thiếu -> chatbot fail-fast.
EMBEDDING_NAME=local
EMBEDDING_DIM=1024
EMBEDDING_MODEL_PATH=/app/weights/Qwen3-Embedding-0.6B
# Chatbot chạy CPU (GPU chỉ dành cho gaze).
EMBEDDING_DEVICE=cpu
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_HF_REPO=Qwen/Qwen3-Embedding-0.6B

# ---------- Cloudflare R2 (tùy chọn) ----------
# Điền cả 5 để lưu slide trên R2.
# Để trống cả 5 để dùng volume local `backend-media`.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# ---------- DB instance ----------
# ID của lần dựng DB; dùng cho namespace media/Redis và invalidate client cũ.
# Để trống để backend tự sinh khi reset (Phase 6).
APP_INSTANCE_ID=

# ---------- Frontend (chỉ dùng khi chạy npm run dev trên host) ----------
# Docker dùng build args trong docker-compose.yml với tên service.
API_INTERNAL_URL=http://localhost:8001
GAZE_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_GAZE_URL=http://localhost:8000

# ---------- Chatbot RAG ----------
# Callback backend nội bộ; không trỏ qua nginx.
CHATBOT_BACKEND_URL=http://backend:8001
# Khớp LLM_TOTAL_CONCURRENCY: request vượt capacity nhận 429 sớm.
CHATBOT_MAX_CONCURRENT=6
CHATBOT_QUEUE_TIMEOUT=2

# Answer: một LLM call streaming.
ANSWER_MAX_TOKENS=2048
ANSWER_TEMPERATURE=0.2

# Query rewrite + HyDE thích nghi (tối đa 1 structured call nhỏ mỗi request).
LLM_QUERY_MAX_TOKENS=400
LLM_QUERY_TIMEOUT=3
QUERY_REWRITE_ENABLED=true
HYDE_ENABLED=true
HYDE_MIN_QUERY_WORDS=8

# Deprecated: pipeline stream ngay và không retry toàn bộ câu trả lời.
CITATION_GATE_TOKENS=200
CITATION_RETRY_MAX=1

# Hybrid retrieval: BM25 (Postgres FTS) + dense pgvector + HyDE, fuse RRF.
RAG_TOP_K=8
RAG_BM25_CANDIDATES=20
RAG_DENSE_CANDIDATES=20
RAG_HYDE_CANDIDATES=20
RAG_HYDE_WEIGHT=0.7
RAG_RRF_K=60
RAG_SCORE_THRESHOLD=0.2

# LMS: regex detection + backend /internal/chat/lms-query.
LMS_DETECTION_ENABLED=true

# Giới hạn concurrency / pacing khi gọi endpoint LLM.
LLM_GENERATION_CONCURRENCY=6
LLM_QUEUE_TIMEOUT=5
LLM_ANSWER_TIMEOUT=120
LLM_TOTAL_CONCURRENCY=6
LLM_REQUESTS_PER_SECOND=0
# Mỗi trang slide chiếm 1 slot VLM; số slot cũng là số thread render/VLM của
# Ingestion. 4 slot khớp CPU quota chatbot và giữ chat p95 ổn định.
VLM_INGEST_CONCURRENCY=4
VLM_INGEST_QUEUE_TIMEOUT=900
# Torch intra-op khớp CPU quota container chatbot (compose cpus: 4).
EMBEDDING_NUM_THREADS=4

# local | r2 — phải khớp backend media backend.
STORAGE_PROVIDER=local
