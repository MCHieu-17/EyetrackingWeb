# ---------- Bắt buộc ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eyetracking

JWT_SECRET=generate-a-long-random-string
CORS_ORIGINS=http://localhost:3000
# Local chạy HTTP: phải false, nếu không login không giữ phiên.
COOKIE_SECURE=false
# Dải mạng proxy tin cậy (nginx trong Docker). Chỉ peer trong dải này mới được
# tin X-Forwarded-For. Không dùng "*".
TRUSTED_PROXY_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
FORWARDED_ALLOW_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# ---------- Microsoft 365 / Outlook OAuth (tùy chọn) ----------
# Điền đủ 3 biến đầu để bật nút "Đăng nhập với Outlook".
# Tenant ID: Microsoft Entra ID -> Overview -> Directory (tenant) ID.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Phải khớp Redirect URI đã đăng ký trong Azure App Registration.
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/oauth/microsoft/callback
# Tùy chọn: giới hạn domain email, phẩy phân tách. Trống = mọi tài khoản tenant.
MICROSOFT_ALLOWED_DOMAINS=
# Origin frontend để redirect sau OAuth callback.
FRONTEND_URL=http://localhost:3000

# DSN nội bộ compose (host `postgres`, cổng 5432).
# Nếu đổi POSTGRES_PASSWORD, sửa cả dòng này.
DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:change-me@postgres:5432/eyetracking
REDIS_URL_DOCKER=redis://redis:6379/0

# ---------- Số replica Docker Compose ----------
# Chỉ áp dụng cho service không đặt container_name (frontend, gaze, worker).
# Giảm xuống 1 khi chạy local để tiết kiệm RAM/CPU.
FRONTEND_REPLICAS=2
GAZE_REPLICAS=2
WORKER_REPLICAS=2

# ---------- Chạy backend/worker trên host (không Docker) ----------
# Docker compose tự set các biến này theo tên service; phần dưới dành cho
# `uvicorn`/worker chạy trực tiếp trên máy (postgres/redis vẫn trong compose).
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5435/eyetracking
REDIS_URL=redis://localhost:6379/0
AI_HTTP_URL=http://localhost:8000
CHATBOT_URL=http://localhost:8002
# Tương đối theo cwd (chạy `cd backend` → backend/media).
MEDIA_DIR=media
MAX_UPLOAD_BYTES=52428800
MAX_PDF_BYTES=104857600
MAX_SLIDE_PAGES=150
WORKER_POLL_SECONDS=5
WORKER_STALE_SECONDS=600
CONTENT_WORKER_POLL_SECONDS=3
EMBEDDING_WORKER_POLL_SECONDS=5
EMBEDDING_WORKER_STALE_SECONDS=600
# Số process API (uvicorn workers). Mỗi process có pool DB riêng.
WEB_CONCURRENCY=2
DB_POOL_MIN=4
DB_POOL_MAX=10
DB_POOL_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
# 0 = tương thích PgBouncer transaction pooling.
DB_PREPARED_STATEMENT_CACHE_SIZE=0
# Gaze: giới hạn queue suy luận và FPS mỗi session.
MAX_INFERENCE_QUEUE=32
MIN_FRAME_INTERVAL_MS=80
# Xoá gaze_samples cũ hơn số ngày này (0 = tắt); schema 10 không dùng partition.
GAZE_RETENTION_DAYS=180
# Giới hạn upload riêng của gaze (không dùng chung MAX_UPLOAD_BYTES backend).
GAZE_MAX_UPLOAD_BYTES=5242880
# Chatbot có pool DB riêng; backend tiếp tục dùng DB_POOL_* phía trên.
CHATBOT_DB_POOL_MIN=1
CHATBOT_DB_POOL_MAX=10
CHATBOT_DB_POOL_TIMEOUT=10
CHATBOT_DB_POOL_RECONNECT_TIMEOUT=10

CHATBOT_INTERNAL_TOKEN=generate-a-long-random-string
CHATBOT_DB_USER=chatbot_reader
CHATBOT_DB_PASSWORD=generate-a-long-random-string
# Nếu đổi CHATBOT_DB_PASSWORD, sửa cả dòng này.
CHATBOT_DATABASE_URL_DOCKER=postgresql://chatbot_reader:generate-a-long-random-string@postgres:5432/eyetracking
# Số slide mỗi request ingest (bài dài được chia batch để không vượt timeout).
CHATBOT_INGEST_BATCH_SIZE=8

# ---------- Truy vấn CSDL cho admin (chỉ đọc) ----------
# Role DB chỉ đọc, được tạo tự động bởi db/migrate.sh khi có 2 biến dưới.
ADMIN_DB_USER=admin_reader
ADMIN_DB_PASSWORD=generate-a-long-random-string
# Nếu đổi ADMIN_DB_PASSWORD, sửa cả 2 DSN dưới đây.
# DSN backend dùng trên host (dev). Để trống → fallback DATABASE_URL + read-only
# transaction (chỉ nên dùng ở dev).
ADMIN_DB_URL=postgresql+asyncpg://admin_reader:generate-a-long-random-string@localhost:5435/eyetracking
# DSN backend dùng trong Docker.
ADMIN_DATABASE_URL_DOCKER=postgresql+asyncpg://admin_reader:generate-a-long-random-string@postgres:5432/eyetracking
ADMIN_DB_STATEMENT_TIMEOUT_MS=10000
ADMIN_DB_LOCK_TIMEOUT_MS=2000
ADMIN_DB_MAX_ROWS=500
ADMIN_DB_SCHEMA_CACHE_SECONDS=60

# ---------- NEU LLM/VLM (OpenAI-compatible) ----------
NEU_BASE_URL=http://101.96.66.232:8037/vllm/v1
NEU_API_KEY=research
NEU_AUTH_HEADER=x-ollama-seckey
NEU_AUTH_SCHEME=
NEU_LLM_MODEL=qwen3.5-35b-a3b-int4
NEU_VLM_MODEL=qwen3.5-35b-a3b-int4
NEU_ENABLE_THINKING=false
NEU_TIMEOUT=180
NEU_MAX_RETRIES=2
NEU_VLM_MAX_TOKENS=8192
NEU_VLM_TIMEOUT=300

EMBEDDING_NAME=local
EMBEDDING_DIM=1024
EMBEDDING_MODEL_PATH=/app/weights/Qwen3-Embedding-0.6B
# Chatbot chạy CPU (GPU chỉ dành cho gaze).
EMBEDDING_DEVICE=cpu

# ---------- Cloudflare R2 (tùy chọn) ----------
# Điền cả 5 để lưu slide trên R2.
# Để trống cả 5 để dùng volume local `backend-media`.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# ---------- DB instance ----------
# ID của lần dựng DB; dùng cho namespace media/Redis và invalidate client cũ.
# Để trống để backend tự sinh khi reset (Phase 6).
APP_INSTANCE_ID=

# ---------- Frontend (chỉ dùng khi chạy npm run dev trên host) ----------
# Docker dùng build args trong docker-compose.yml với tên service.
API_INTERNAL_URL=http://localhost:8001
GAZE_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_GAZE_URL=http://localhost:8000

# ---------- Chatbot RAG ----------
# Callback backend nội bộ; không trỏ qua nginx.
CHATBOT_BACKEND_URL=http://backend:8001
CHATBOT_MAX_CONCURRENT=20
CHATBOT_QUEUE_TIMEOUT=2

# Answer: một LLM call streaming.
ANSWER_MAX_TOKENS=2048
ANSWER_TEMPERATURE=0.2

# Query rewrite + HyDE thích nghi (tối đa 1 structured call nhỏ mỗi request).
NEU_QUERY_MAX_TOKENS=400
NEU_QUERY_TIMEOUT=30
QUERY_REWRITE_ENABLED=true
HYDE_ENABLED=true
HYDE_MIN_QUERY_WORDS=8

# Citation gate bằng code; retry tối đa 1 lần.
CITATION_GATE_TOKENS=200
CITATION_RETRY_MAX=1

# Hybrid retrieval: BM25 (Postgres FTS) + dense pgvector + HyDE, fuse RRF.
RAG_TOP_K=8
RAG_BM25_CANDIDATES=20
RAG_DENSE_CANDIDATES=20
RAG_HYDE_CANDIDATES=20
RAG_HYDE_WEIGHT=0.7
RAG_RRF_K=60
RAG_SCORE_THRESHOLD=0.2

# LMS: regex detection + backend /internal/chat/lms-query.
LMS_DETECTION_ENABLED=true

# Giới hạn concurrency / pacing khi gọi NEU.
NEU_GENERATION_CONCURRENCY=4
NEU_QUEUE_TIMEOUT=30
NEU_ANSWER_TIMEOUT=120
NEU_TOTAL_CONCURRENCY=6
NEU_REQUESTS_PER_SECOND=0
VLM_INGEST_CONCURRENCY=1
VLM_INGEST_QUEUE_TIMEOUT=60

# local | r2 — phải khớp backend media backend.
STORAGE_PROVIDER=local
