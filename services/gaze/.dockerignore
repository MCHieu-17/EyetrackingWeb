# ============================================================
# .dockerignore — loại file không cần thiết khỏi build context
# ============================================================

# --- Weights: do service gaze-export tải/convert, không đưa vào build context ---
weights/
*.safetensors
*.tflite
*.ubj

# --- Python ---
**/__pycache__/
**/*.py[cod]
*$py.class
*.egg-info/
**/.venv/
**/venv/
**/.mypy_cache/
**/.ruff_cache/

# --- Git & bí mật ---
.git/
.gitignore
.env
.env.*

# --- Tài liệu & compose (không cần trong image) ---
README.md
*.md
docker-compose*.yml

# --- IDE / OS ---
.idea/
.vscode/
.DS_Store
*.task
*.onnx
*.onnx.json
