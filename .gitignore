# =========================================================
# Git ignore hợp nhất cho toàn repo EyeLearning
# =========================================================

# IDE / OS
.vscode/
.idea/
.DS_Store

# Python
__pycache__/
*.pyc
.ruff_cache/
backend/.venv/
backend/venv/

# Env (giữ .env.example)
.env
frontend/.env*
# Env thật cho Portainer stack; chỉ commit stack.env.example
deploy/portainer/stack.env

# Log local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Backup DB local (scripts/backup.sh)
backups/

# Gaze: weights tải runtime + DB dev cục bộ
services/gaze/weights/
services/gaze/my_database.db

# Chatbot: weights tải runtime + venv local
services/chatbot/weights/
services/chatbot/.venv/

# Media upload local
backend/media/

# ---------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------

# Dependencies
frontend/node_modules/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions

# Next.js
frontend/.next/
frontend/out/
frontend/build/
frontend/test-results/
frontend/e2e/.fixtures.json
frontend/e2e/.auth-*.json
frontend/playwright-report/
frontend/blob-report/

# Next.js tự sinh khi phát hiện AI agent; đã tắt bằng agentRules: false
frontend/AGENTS.md
frontend/CLAUDE.md

# PDF.js worker/assets được copy từ node_modules khi dev/build
frontend/public/pdf.worker.min.mjs
frontend/public/pdfjs/

# Vercel
frontend/.vercel

# TypeScript
*.tsbuildinfo
frontend/next-env.d.ts

# Misc
*.pem


# AGENTS.md
# DB.md
# cv/
# docs/
docs/ui-redesign/logs/
