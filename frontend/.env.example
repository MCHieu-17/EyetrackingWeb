# URL nội bộ cho rewrite phía server (Next.js). Dev trên host dùng localhost;
# trong Docker dùng tên service (backend:8001, gaze:8000).
API_INTERNAL_URL=http://localhost:8001
GAZE_INTERNAL_URL=http://localhost:8000

# Origin công khai cho browser. Để trống = same-origin qua rewrite.
# Chỉ đặt khi browser phải gọi thẳng domain (vd https://api.eyelearning.id.vn).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_GAZE_URL=

NEXT_PUBLIC_DEMO=0
