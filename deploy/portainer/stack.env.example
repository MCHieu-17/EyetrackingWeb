# ============================================================
# Env mẫu cho Portainer stack (production)
# ------------------------------------------------------------
# KHÔNG commit file stack.env thật. Copy file này thành stack.env,
# điền secret, rồi dán vào Portainer → Stacks → Environment variables
# (hoặc dùng "Load variables from .env file").
#
# Secret nên dạng hex để tránh ký tự đặc biệt làm hỏng DSN:
#   openssl rand -hex 32
# ============================================================

# ---------- Image ----------
# GHCR public là mặc định vì repo đang public.
# Nếu dùng registry khác, đổi prefix (không có dấu / ở cuối).
IMAGE_PREFIX=ghcr.io/mchieu-17
# Tag release (khuyến nghị), ví dụ v1.0.0; hoặc latest.
IMAGE_TAG=v1.0.0

# ---------- Cloudflare Tunnel ----------
# Token lấy từ Zero Trust → Networks → Tunnels → tunnel → Install connector.
# Public hostname của tunnel phải trỏ service HTTP tới `nginx:80`.
TUNNEL_TOKEN=

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=eyetracking

# ---------- Auth / OTP ----------
JWT_SECRET=
OTP_HASH_SECRET=
CHATBOT_INTERNAL_TOKEN=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- URL công khai ----------
# Phải khớp chính xác origin trình duyệt dùng; CSRF kiểm tra Origin.
# Trong lúc test staging, thêm origin staging vào CORS_ORIGINS.
CORS_ORIGINS=https://eyetracking.nmhieu17.space
FRONTEND_URL=https://eyetracking.nmhieu17.space
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---------- Proxy tin cậy ----------
TRUSTED_PROXY_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
FORWARDED_ALLOW_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# ---------- DB role cho chatbot / admin read-only ----------
CHATBOT_DB_USER=chatbot_reader
CHATBOT_DB_PASSWORD=
ADMIN_DB_USER=admin_reader
ADMIN_DB_PASSWORD=

# ---------- SMTP gửi OTP ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=GazeEdu
SMTP_REPLY_TO=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15

# ---------- OTP ----------
OTP_TTL_SECONDS=900
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_EMAIL_PER_HOUR=10
OTP_MAX_PER_IP_PER_HOUR=40
OTP_ALLOWED_DOMAINS=st.neu.edu.vn
OTP_STUDENT_ID_PATTERN=^\d{8}$

# ---------- NEU LLM/VLM ----------
NEU_BASE_URL=http://101.96.66.232:8037/vllm/v1
NEU_API_KEY=
NEU_AUTH_HEADER=x-ollama-seckey
NEU_AUTH_SCHEME=
NEU_LLM_MODEL=qwen3.5-35b-a3b-int4
NEU_VLM_MODEL=qwen3.5-35b-a3b-int4
NEU_ENABLE_THINKING=false
NEU_TIMEOUT=180
NEU_MAX_RETRIES=2
NEU_VLM_MAX_TOKENS=8192
NEU_VLM_TIMEOUT=300

# ---------- Model embedding chạy local (bắt buộc) ----------
# Thiếu một biến -> chatbot fail-fast; không có default trong code/compose.
EMBEDDING_NAME=local
EMBEDDING_DIM=1024
EMBEDDING_MODEL_PATH=/app/weights/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_HF_REPO=Qwen/Qwen3-Embedding-0.6B
HF_TOKEN=

# ---------- Cloudflare R2 (tùy chọn) ----------
# Điền đủ 5 biến + STORAGE_PROVIDER=r2 để lưu slide trên R2.
# Để trống toàn bộ để dùng volume local backend-media.
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# ---------- Model gaze chạy local (bắt buộc) ----------
# Thiếu một biến -> gaze fail-fast; không có default trong code/compose.
DEVICE=cuda
# unigaze_b16_joint | unigaze_l16_joint | unigaze_h14_joint | unigaze_h14_cross_X
UNIGAZE_MODEL=unigaze_b16_joint
GAZE_RETENTION_DAYS=180
CONTENT_VIEW_MIN_DWELL_MS=1000
GAZE_MAX_UPLOAD_BYTES=5242880
MIN_FRAME_INTERVAL_MS=80
MAX_INFERENCE_QUEUE=32

# ---------- Sizing / replicas ----------
# Production mặc định 1 instance mỗi service. Có thể tăng sau khi đo tải.
WEB_CONCURRENCY=2
DB_POOL_MIN=4
DB_POOL_MAX=10
DB_POOL_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_PREPARED_STATEMENT_CACHE_SIZE=0
CHATBOT_DB_POOL_MIN=1
CHATBOT_DB_POOL_MAX=10
CHATBOT_DB_POOL_TIMEOUT=10
CHATBOT_DB_POOL_RECONNECT_TIMEOUT=10

# ---------- Worker ----------
WORKER_POLL_SECONDS=5
WORKER_STALE_SECONDS=600
CONTENT_WORKER_POLL_SECONDS=3
CONTENT_WORKER_STALE_SECONDS=600
EMBEDDING_WORKER_POLL_SECONDS=5
EMBEDDING_WORKER_STALE_SECONDS=600

# ---------- Upload ----------
MAX_UPLOAD_BYTES=52428800
MAX_PDF_BYTES=104857600
MAX_SLIDE_PAGES=150
MAX_SLIDE_RENDER_PIXELS=25000000

# ---------- Chatbot tuning (có thể giữ mặc định) ----------
CHATBOT_MAX_CONCURRENT=20
CHATBOT_QUEUE_TIMEOUT=2
NEU_GENERATION_CONCURRENCY=4
NEU_TOTAL_CONCURRENCY=6
NEU_REQUESTS_PER_SECOND=0
NEU_ANSWER_TIMEOUT=120
VLM_INGEST_CONCURRENCY=1
VLM_INGEST_QUEUE_TIMEOUT=60
NEU_QUEUE_TIMEOUT=30
RAG_TOP_K=8
RAG_BM25_CANDIDATES=20
RAG_DENSE_CANDIDATES=20
RAG_HYDE_CANDIDATES=20
RAG_HYDE_WEIGHT=0.7
RAG_RRF_K=60
RAG_SCORE_THRESHOLD=0.2
